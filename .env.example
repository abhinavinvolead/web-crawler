# Copy to .env. Never commit .env.
# Leave BRIGHTDATA_API_KEY empty to run in MOCK mode (zero credits, synthetic data).
BRIGHTDATA_API_KEY=
# Force a mode explicitly: true = mock, false = live. With a key, live is the default.
# BD_MOCK=false

# Verified defaults (Google Maps). Override only if Bright Data changes them.
# BD_DATASET_GMAPS_REVIEWS=gd_luzfs1dn2oa0teb81
# BD_DATASET_GMAPS_PLACES=gd_m8ebnr0q2qlklc02fz

# Tripadvisor / Yelp: find IDs via GET /api/v1/brightdata/scrapers?q=tripadvisor, then pin here.
# BD_DATASET_TRIPADVISOR=
# BD_DATASET_YELP=

DB_PATH=data/reviews.db
EXPORT_DIR=data/exports
BD_POLL_INTERVAL=5
BD_POLL_TIMEOUT=180
MAX_PLACES_HARD_CAP=50

# Optional: LLM sentiment analyzer (method=llm)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
